---
# ---------------------------------------------------------------------------
# 基线：以 Google C++ Style 为基线，按 C++17 语法解析。
# 下面只列出相对 Google 预设做了覆盖、或需要特别强调的项。
# ---------------------------------------------------------------------------
Language:        Cpp
BasedOnStyle:    Google
Standard:        c++17

# ---------------------------------------------------------------------------
# 缩进：4 空格，tab 宽度按 4 计，禁用 Tab 字符。
# （本地约定；Google 预设为 2 空格。）
# ---------------------------------------------------------------------------
IndentWidth:     4
TabWidth:        4
UseTab:          Never

# ---------------------------------------------------------------------------
# 行宽：超过 80 列由格式化器自动换行。
# ---------------------------------------------------------------------------
ColumnLimit:     80

# ---------------------------------------------------------------------------
# 类体访问修饰符（public:/private:/protected:）顶到列 0。
# 实际缩进 = IndentWidth + AccessModifierOffset = 4 + (-4) = 0。
# （Google 预设为 -1，是配合它的 IndentWidth=2 用的，本项目 4 空格下会变成
#   3 空格，故覆盖为 -4。）
# ---------------------------------------------------------------------------
AccessModifierOffset: -4

# ---------------------------------------------------------------------------
# 指针 / 引用符号靠左书写（int* p、int& r）。
# DerivePointerAlignment=false：不从代码中首个指针自动推断对齐风格，
# 始终以 PointerAlignment 为准。
# ---------------------------------------------------------------------------
DerivePointerAlignment: false
PointerAlignment: Left

# ---------------------------------------------------------------------------
# 控制语句风格：不写成单行，且单语句块也补全花括号、花括号独占行。
#   结果形如：if (cond) { return; }  展开为
#             if (cond) {
#                 return;
#             }
# AllowShortIfStatementsOnASingleLine: 禁止单行 if。
# AllowShortBlocksOnASingleLine:       禁止把 { ... } 压成一行。
# InsertBraces:                        给缺少花括号的控制块补上 {}。
# ---------------------------------------------------------------------------
AllowShortIfStatementsOnASingleLine: Never
AllowShortBlocksOnASingleLine:       Never
InsertBraces:                        true

# ---------------------------------------------------------------------------
# 函数 / 类 / struct / enum 等定义块之间强制保留一个空行。
# ---------------------------------------------------------------------------
SeparateDefinitionBlocks: Always
...
